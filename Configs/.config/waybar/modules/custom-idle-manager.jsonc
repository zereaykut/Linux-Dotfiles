{
    "custom/idle-manager": {
        "format" : "{}",
        "exec": "~/.config/waybar/scripts/idle-manager-status.sh",
        "interval": 1,
        "tooltip": true,
        "exec-if": "exit 0",
        "return-type": "json",
        "menu": "on-click",
        "menu-file": "~/.config/waybar/menus/idle-manager.xml",
        "menu-actions": {
            "activate": "idle-manager.sh activated",
            "deactivate": "idle-manager.sh deactivated",
                },
    },
}