{
    "custom/global-menu": {
        "format" : "󰍜",
        // "exec": "~/.config/waybar/scripts/global-menu.sh",
        "tooltip": false,
        // "exec-if": "exit 0",
        // "return-type": "json",
        "menu": "on-click",
        "menu-file": "~/.config/waybar/menus/global-menu.xml",
        "menu-actions": {
            // Power Actions
            "shutdown": "systemctl poweroff",
            "restart": "systemctl reboot",
            "logout": "loginctl terminate-user $USER",

            // Power Profiles
            "performance": "powerprofilesctl set performance",
            "balanced": "powerprofilesctl set balanced",
            "power-saver": "powerprofilesctl set power-saver",

            // Daemon Scripts
            "osd": "start-osd.sh",
            "topbar": "start-top-bar.sh",
            "notification": "start-notification-daemon.sh",
            "wallpaper": "start-wallpaper-daemon.sh",

            // Theme Actions
            "theme-select": "theme-select.sh",
            "wallpaper-select": "wall-select.sh", 
            "sddm-theme-select": "theme-select-sddm.sh",

            // Scripts Actions
            "app-launcher": "app-launcher.sh 'applications'",
            "clipboard": "app-launcher.sh 'clipboard'",
            "tab-menu": "app-launcher.sh 'window-management'",
            "close-all-windows": "close-all-windows.sh",
        }
    },
}