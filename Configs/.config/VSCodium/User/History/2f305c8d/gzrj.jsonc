{
    "custom/power-profiles-daemon": {
        "format" : "{}",
        "exec": "~/.local/share/bin/idle_manager.sh",
        "interval": 1,
        "tooltip": true,
        "exec-if": "exit 0",
        "return-type": "json",
        "menu": "on-click",
        "menu-file": "~/.config/waybar/menus/idle_manager.xml",
        "menu-actions": {
            "performance": "powerprofilesctl set performance",
            "balanced": "powerprofilesctl set balanced",
            "power-saver": "powerprofilesctl set power-saver"
                },
    },
}